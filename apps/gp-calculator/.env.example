DATABASE_URL="postgresql://gp:gp@localhost:5432/gp_calculator"
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=gp-calculator@yourdomain.com
# Where the launcher menu lives (top bar "Menu" link). Defaults to the GitHub Pages site.
NEXT_PUBLIC_HOME_URL=

# Sign-in. In development both fall back to a temporary password (555666). In production they are
# REQUIRED: without them nobody can sign in. Use a long random string for the secret.
GP_PASSWORD=
GP_SESSION_SECRET=
